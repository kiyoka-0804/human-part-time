# 复制为 .env 后填写。API Key 只放在本机环境变量中，不要写进代码或聊天记录。
OPENAI_API_KEY=
# CC Switch 命名时可填此项；OPENAI_API_KEY 优先
ANTHROPIC_AUTH_TOKEN=
# 官方 OpenAI 可留空；OpenAI-compatible 服务填写其兼容 API 根地址，例如 https://example.com/v1
OPENAI_BASE_URL=
# 兼容旧配置名；OPENAI_BASE_URL 优先
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
# 大多数服务保持 true；如果兼容服务不支持 response_format，可改为 false
OPENAI_JSON_MODE=true
PORT=3000
